{
  "name": "vwo-playwright-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright + TypeScript automation framework for VWO login",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:allure": "allure generate allure-results --clean -o allure-report",
    "test:allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf allure-results allure-report playwright-report test-results"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "page-object-model",
    "allure"
  ],
  "author": "QA Automation Architect",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
