<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SalesforceLoginSuite" verbose="2" parallel="false">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="ValidLoginTests">
        <classes>
            <class name="com.salesforce.login.tests.ValidLoginTest"/>
        </classes>
    </test>
    <test name="InvalidLoginTests">
        <classes>
            <class name="com.salesforce.login.tests.InvalidLoginTest"/>
        </classes>
    </test>
</suite>
